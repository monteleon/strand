# Strand — environment configuration
# Copy to .env and adjust as needed. .env is gitignored.

# Path to the SQLite database file (relative to project root)
STRAND_DB_PATH=data/strand.db

# Single-tenant mode by default — every row carries tenant_id='local'.
# Swap to 'multi' when the hosted multi-tenant fork lands (post-v0.1.0).
STRAND_TENANT_MODE=single
